    {
      "id": "PUB-LAW-2026",
      "title": "中华人民共和国危险化学品安全法",
      "publisher": "全国人民代表大会常务委员会",
      "url": "https://www.sz.msa.gov.cn/flfg/2215930.jhtml",
      "published_at": "2026-01-15",
      "source_family": "hazardous-chemical-safety-law",
      "kind": "public",
      "external_model_allowed": false,
      "excerpt_path": "excerpts/PUB-LAW-2026.txt",
      "excerpt_sha256": "e1ceb5d6cba430390b0bada808a3c0df2b77aa888a52283fe810b8ec4e55617d",
      "passages": [
        {
          "locator": "L1",
          "source_locator": "第五条第二款人员培训片段",
          "quote": "从业人员应当接受教育和培训，考核合格后上岗作业；对有资格要求的岗位，应当配备依法取得相应资格的人员。"
        },
        {
          "locator": "L2",
          "source_locator": "第四十一条第一款",
          "quote": "第四十一条　危险化学品应当储存在专用仓库、专用场地或者专用储存室、储存专柜（以下统称专用储存场所）内，并由专人负责管理；剧毒化学品以及储存数量构成重大危险源的其他危险化学品，应当在专用储存场所内单独存放，实行双人收发、双人保管制度，收发记录的保存期限不得少于三年。"
        },
        {
          "locator": "L3",
          "source_locator": "第四十二条第一款",
          "quote": "第四十二条　储存危险化学品的单位应当建立危险化学品出入库核查、登记制度。"
        },
        {
          "locator": "L4",
          "source_locator": "第五十一条第一款",
          "quote": "第五十一条　使用危险化学品的单位应当将其作业场所使用的化学品安全技术说明书和化学品安全标签提供给从业人员，并加强培训教育，告知从业人员正确使用的方法和在紧急情况下应当采取的措施。"
        },
        {
          "locator": "L5",
          "source_locator": "第一百二十七条",
          "quote": "第一百二十七条　本法自2026年5月1日起施行。"
        }
      ],

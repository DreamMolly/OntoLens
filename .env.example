# Optional OpenAI-compatible explanation model. Leave blank for offline mode.
PEIWU_MODEL_BASE_URL=
PEIWU_MODEL_NAME=
PEIWU_MODEL_API_KEY=
PEIWU_MODEL_PROTOCOL=chat_completions

# Optional TypeSafe JEV evidence reranker. Keep the key outside the repository.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Display priority only; calibrate against held-out project data before relying on it.
TYPESAFE_JEV_REVIEW_THRESHOLD=0.75

# Required only when an MCP client outside localhost reaches the workbench.
PEIWU_MCP_TOKEN=

# start-workbench.ps1 keeps local state under the cloned project directory.

# New business workspaces contain no sample facts. Use synthetic only for isolated tests.
PEIWU_WORKSPACE_MODE=operational
# Optional authenticated accounts; start-operational.ps1 sets these paths automatically.
PEIWU_AUTH_FILE=
PEIWU_SESSION_DB=
PEIWU_COOKIE_SECURE=false
PEIWU_ALLOWED_HOSTS=

# Live Nexent adapter. The dedicated explanation Agent must have no tools or skills.
PEIWU_NEXENT_BASE_URL=
PEIWU_NEXENT_AGENT_NAME=ontolens_result_explainer
PEIWU_NEXENT_AGENT_ID=
PEIWU_NEXENT_API_TOKEN=
